# TEMPLAT. Salin ke `.env.<env>` (diabaikan git) lalu isi di mesin operator/secret manager.
# JANGAN commit nilai nyata. Lingkungan: pengembangan | staging | produksi.
PEDAREE_ENV=pengembangan

# DB logis `pedaree` (satu DB per service). Dilarang menunjuk DB divisi lain.
DATABASE_URL=postgres://pedaree_app:GANTI_PASSWORD@HOST_DB:5432/pedaree?sslmode=require

# Kunci penandatangan JWT, audiens `pedaree` (akses 15 menit, refresh 7 hari). Buat per env, jangan dipakai ulang.
JWT_SIGNING_KEY=GANTI_DENGAN_KUNCI_ACAK_PANJANG

# X-Service-Key ke TitipO (POST /sinyal/pedaree-stok). Hak minimal: hanya endpoint sinyal.
TITIPO_SERVICE_KEY=GANTI_SERVICE_KEY_DARI_TITIPO

# API key per device, satu baris per device: <device_id>:<key>
DEVICE_API_KEYS=GANTI_device-001:KEY_ACAK
